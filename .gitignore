# ==========================================
# PublisherAI Platform — Git Ignore Rules
# ==========================================

# --- Node / Next.js Frontend ---
node_modules/
frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
frontend/.next/
out/
build/
dist/

# TypeScript & Next definitions
*.tsbuildinfo
next-env.d.ts

# --- Python / FastAPI Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/app/__pycache__/

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python build & distribution artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Database & Storage ---
*.db
*.sqlite
*.sqlite3
publisherai.db
backend/publisherai.db
data/*.db
backend/data/*.db

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
config.json
settings.json

# --- OS & IDE Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Logs & Debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
backend/*.log
